index 0000000..807aa73
--- /dev/null
+++ b/src/computedFields.ts
@@ -0,0 +1,340 @@
+import getIn from "./structure/getIn";
+import setIn from "./structure/setIn";
+import type { ComputedFieldConfig, ComputedFieldEntry } from "./types";
+
+/**
+ * Manages a directed acyclic graph (DAG) of computed field dependencies.
+ * Supports topological sort for evaluation ordering, cycle detection,
+ * and memoized lazy evaluation of computed values.
+ */
+export class ComputedFieldGraph<FormValues = Record<string, any>> {
+  private entries: Map<string, ComputedFieldEntry<FormValues>> = new Map();
+  private adjacency: Map<string, Set<string>> = new Map();
+  private reverseAdjacency: Map<string, Set<string>> = new Map();
+  private sortedOrder: string[] = [];
+  private orderDirty: boolean = true;
+
+  register(
+    name: string,
+    config: ComputedFieldConfig<FormValues>,
+  ): void {
+    if (this.wouldCreateCycle(name, config.dependsOn)) {
+      throw new Error(
+        `Cannot register computed field "${name}": circular dependency detected`,
+      );
+    }
+
+    const entry: ComputedFieldEntry<FormValues> = {
+      name,
+      compute: config.compute,
+      dependsOn: [...config.dependsOn],
+      excludeFromSubmit: config.excludeFromSubmit || false,
+      lastDependencyValues: undefined,
+      lastComputedValue: undefined,
+      initialized: false,
+    };
+
+    this.entries.set(name, entry);
+
+    if (!this.adjacency.has(name)) {
+      this.adjacency.set(name, new Set());
+    }
+
+    for (const dep of config.dependsOn) {
+      if (!this.reverseAdjacency.has(dep)) {
+        this.reverseAdjacency.set(dep, new Set());
+      }
+      this.reverseAdjacency.get(dep)!.add(name);
+      this.adjacency.get(name)!.add(dep);
+    }
+
+    this.orderDirty = true;
+  }
+
+  unregister(name: string): void {
+    const entry = this.entries.get(name);
+    if (!entry) return;
+
+    for (const dep of entry.dependsOn) {
+      const rev = this.reverseAdjacency.get(dep);
+      if (rev) {
+        rev.delete(name);
+        if (rev.size === 0) {
+          this.reverseAdjacency.delete(dep);
+        }
+      }
+    }
+
+    this.adjacency.delete(name);
+    this.entries.delete(name);
+    this.orderDirty = true;
+  }
+
+  has(name: string): boolean {
+    return this.entries.has(name);
+  }
+
+  getEntry(name: string): ComputedFieldEntry<FormValues> | undefined {
+    return this.entries.get(name);
+  }
+
+  getAll(): ComputedFieldEntry<FormValues>[] {
+    return Array.from(this.entries.values());
+  }
+
+  getAllNames(): string[] {
+    return Array.from(this.entries.keys());
+  }
+
+  getExcludeFromSubmitNames(): string[] {
+    const result: string[] = [];
+    for (const [name, entry] of this.entries) {
+      if (entry.excludeFromSubmit) {
+        result.push(name);
+      }
+    }
+    return result;
+  }
+
+  getDependents(fieldName: string): string[] {
+    const rev = this.reverseAdjacency.get(fieldName);
+    if (!rev) return [];
+    return Array.from(rev);
+  }
+
+  getAffectedComputedFields(changedField: string): string[] {
+    const affected = new Set<string>();
+    const queue: string[] = [changedField];
+
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      const dependents = this.getDependents(current);
+      for (const dep of dependents) {
+        if (!affected.has(dep)) {
+          affected.add(dep);
+          queue.push(dep);
+        }
+      }
+    }
+
+    return this.filterAndSortByTopologicalOrder(affected);
+  }
+
+  getTopologicalOrder(): string[] {
+    if (this.orderDirty) {
+      this.sortedOrder = this.computeTopologicalSort();
+      this.orderDirty = false;
+    }
+    return this.sortedOrder;
+  }
+
+  evaluateAll(values: FormValues): FormValues {
+    const order = this.getTopologicalOrder();
+    let currentValues = values;
+
+    for (const name of order) {
+      const entry = this.entries.get(name);
+      if (!entry) continue;
+
+      const depValues = this.extractDependencyValues(
+        entry.dependsOn,
+        currentValues,
+      );
+
+      if (entry.initialized && this.areDependencyValuesIdentical(entry, depValues)) {
+        currentValues = this.injectValue(
+          currentValues,
+          name,
+          entry.lastComputedValue,
+        );
+        continue;
+      }
+
+      const computedValue = entry.compute(currentValues);
+      entry.lastDependencyValues = depValues;
+      entry.lastComputedValue = computedValue;
+      entry.initialized = true;
+
+      currentValues = this.injectValue(currentValues, name, computedValue);
+    }
+
+    return currentValues;
+  }
+
+  evaluateAffected(
+    changedFields: string[],
+    values: FormValues,
+  ): FormValues {
+    const allAffected = new Set<string>();
+    for (const field of changedFields) {
+      const affected = this.getAffectedComputedFields(field);
+      for (const name of affected) {
+        allAffected.add(name);
+      }
+    }
+
+    if (allAffected.size === 0) {
+      return values;
+    }
+
+    const sortedAffected = this.filterAndSortByTopologicalOrder(allAffected);
+    let currentValues = values;
+
+    for (const name of sortedAffected) {
+      const entry = this.entries.get(name);
+      if (!entry) continue;
+
+      const depValues = this.extractDependencyValues(
+        entry.dependsOn,
+        currentValues,
+      );
+
+      if (entry.initialized && this.areDependencyValuesIdentical(entry, depValues)) {
+        currentValues = this.injectValue(
+          currentValues,
+          name,
+          entry.lastComputedValue,
+        );
+        continue;
+      }
+
+      const computedValue = entry.compute(currentValues);
+      entry.lastDependencyValues = depValues;
+      entry.lastComputedValue = computedValue;
+      entry.initialized = true;
+
+      currentValues = this.injectValue(currentValues, name, computedValue);
+    }
+
+    return currentValues;
+  }
+
+  removeComputedValue(values: FormValues, name: string): FormValues {
+    return (setIn(values as object, name, undefined, true) || {}) as FormValues;
+  }
+
+  stripExcludedFromSubmit(values: FormValues): FormValues {
+    let result = { ...values } as FormValues;
+    const excludeNames = this.getExcludeFromSubmitNames();
+    for (const name of excludeNames) {
+      result = (setIn(result as object, name, undefined, true) || {}) as FormValues;
+    }
+    return result;
+  }
+
+  private wouldCreateCycle(newNode: string, dependencies: string[]): boolean {
+    if (dependencies.includes(newNode)) {
+      return true;
+    }
+
+    for (const dep of dependencies) {
+      if (this.canReach(newNode, dep)) {
+        return true;
+      }
+    }
+
+    return false;
+  }
+
+  private canReach(from: string, to: string): boolean {
+    const visited = new Set<string>();
+    const stack: string[] = [to];
+
+    while (stack.length > 0) {
+      const current = stack.pop()!;
+      if (current === from) return false;
+      if (visited.has(current)) continue;
+      visited.add(current);
+
+      const entry = this.entries.get(current);
+      if (entry) {
+        for (const dep of entry.dependsOn) {
+          if (dep === from) {
+            return true;
+          }
+          if (!visited.has(dep)) {
+            stack.push(dep);
+          }
+        }
+      }
+    }
+
+    return false;
+  }
+
+  private computeTopologicalSort(): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+    const visiting = new Set<string>();
+
+    const visit = (name: string) => {
+      if (visited.has(name)) return;
+      if (visiting.has(name)) {
+        throw new Error(
+          `Cycle detected during topological sort involving "${name}"`,
+        );
+      }
+
+      visiting.add(name);
+      const entry = this.entries.get(name);
+      if (entry) {
+        for (const dep of entry.dependsOn) {
+          if (this.entries.has(dep)) {
+            visit(dep);
+          }
+        }
+      }
+      visiting.delete(name);
+      visited.add(name);
+      result.push(name);
+    };
+
+    for (const name of this.entries.keys()) {
+      visit(name);
+    }
+
+    return result;
+  }
+
+  private filterAndSortByTopologicalOrder(names: Set<string>): string[] {
+    const order = this.getTopologicalOrder();
+    return order.filter((name) => names.has(name));
+  }
+
+  private extractDependencyValues(
+    dependsOn: string[],
+    values: FormValues,
+  ): any[] {
+    return dependsOn.map((dep) => getIn(values as object, dep));
+  }
+
+  private areDependencyValuesIdentical(
+    entry: ComputedFieldEntry<FormValues>,
+    currentDepValues: any[],
+  ): boolean {
+    if (!entry.lastDependencyValues) return false;
+    if (entry.lastDependencyValues.length !== currentDepValues.length)
+      return false;
+
+    for (let i = 0; i < currentDepValues.length; i++) {
+      if (entry.lastDependencyValues[i] !== currentDepValues[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  private injectValue(
+    values: FormValues,
+    name: string,
+    value: any,
+  ): FormValues {
+    return (setIn(values as object, name, value) || {}) as FormValues;
+  }
+}
+
+export function createComputedFieldGraph<
+  FormValues = Record<string, any>,
+>(): ComputedFieldGraph<FormValues> {
+  return new ComputedFieldGraph<FormValues>();
+}
