+    });
+  });
+
+  // ─── Batch Coalescing ────────────────────────────────────────────────
+
+  describe("batch coalescing", () => {
+    it("should compute at most once per batch even with multiple dependency changes", () => {
+      const compute = jest.fn(
+        (values) => (values.a || 0) + (values.b || 0) + (values.c || 0),
+      );
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { a: 1, b: 2, c: 3 },
+      });
+      form.registerField("a", () => {}, { value: true });
+      form.registerField("b", () => {}, { value: true });
+      form.registerField("c", () => {}, { value: true });
+      form.registerComputedField("total", {
+        compute,
+        dependsOn: ["a", "b", "c"],
+      });
+
+      const countAfterReg = compute.mock.calls.length;
+      form.batch(() => {
+        form.change("a", 10);
+        form.change("b", 20);
+        form.change("c", 30);
+      });
+
+      // compute should have been called exactly once for the batch
+      expect(compute.mock.calls.length).toBe(countAfterReg + 1);
+      expect(form.getState().values.total).toBe(60);
+    });
+
+    it("should produce correct result after batch with transitive dependencies", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 1 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      form.registerComputedField("a", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+      form.registerComputedField("b", {
+        compute: (values) => (values.a || 0) + 100,
+        dependsOn: ["a"],
+      });
+
+      form.batch(() => {
+        form.change("x", 5);
+      });
+
+      expect(form.getState().values.a).toBe(10);
+      expect(form.getState().values.b).toBe(110);
+    });
+
+    it("should not fire subscriber notifications mid-batch", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { a: 0, b: 0 },
+      });
+      form.registerField("a", () => {}, { value: true });
+      form.registerField("b", () => {}, { value: true });
+      form.registerComputedField("sum", {
+        compute: (values) => (values.a || 0) + (values.b || 0),
+        dependsOn: ["a", "b"],
+      });
+
+      const sub = jest.fn();
+      form.subscribe(sub, { values: true });
+      sub.mockClear();
+
+      form.batch(() => {
+        form.change("a", 5);
+        form.change("b", 10);
+        // subscriber should NOT have been called mid-batch
+        expect(sub).not.toHaveBeenCalled();
+      });
+
+      // After batch, subscriber should have been called with final values
+      expect(sub).toHaveBeenCalled();
+      const lastCall = sub.mock.calls[sub.mock.calls.length - 1][0];
+      expect(lastCall.values.sum).toBe(15);
+    });
+  });
+
+  // ─── Edge Cases & Traps ──────────────────────────────────────────────
+
+  describe("edge cases", () => {
+    it("should handle computed field registered before its dependency fields exist", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 7 },
+      });
+      // Register computed field first, before any regular field is registered
+      form.registerComputedField("doubled", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.doubled).toBe(14);
+
+      // Now register the dependency field and change it
+      form.registerField("x", () => {}, { value: true });
+      form.change("x", 3);
+      expect(form.getState().values.doubled).toBe(6);
+    });
+
+    it("should handle computed field with empty dependsOn array", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 1 },
+      });
+      form.registerComputedField("constant", {
+        compute: () => 42,
+        dependsOn: [],
+      });
+      expect(form.getState().values.constant).toBe(42);
+    });
+
+    it("should handle computed field whose compute returns undefined", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: undefined },
+      });
+      form.registerComputedField("undef", {
+        compute: (values) => values.x,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.undef).toBeUndefined();
+    });
+
+    it("should handle computed field whose compute returns null", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 1 },
+      });
+      form.registerComputedField("nullField", {
+        compute: () => null,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.nullField).toBeNull();
+    });
+
+    it("should handle computed field whose compute returns an object", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { first: "John", last: "Doe" },
+      });
+      form.registerField("first", () => {}, { value: true });
+      form.registerField("last", () => {}, { value: true });
+      form.registerComputedField("nameObj", {
+        compute: (values) => ({
+          display: `${values.first} ${values.last}`,
+          initials: `${(values.first || "")[0]}${(values.last || "")[0]}`,
+        }),
+        dependsOn: ["first", "last"],
+      });
+
+      expect(form.getState().values.nameObj).toEqual({
+        display: "John Doe",
+        initials: "JD",
+      });
+
+      form.change("first", "Jane");
+      expect(form.getState().values.nameObj).toEqual({
+        display: "Jane Doe",
+        initials: "JD",
+      });
+    });
+
+    it("should clean up computed value from form values on unsubscribe", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 5 },
+      });
+      const unsub = form.registerComputedField("doubled", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.doubled).toBe(10);
+
+      unsub();
+      expect(form.getState().values.doubled).toBeUndefined();
+    });
+
+    it("should not recompute after unsubscribe when former dependencies change", () => {
+      const compute = jest.fn((values) => (values.x || 0) * 2);
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 5 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      const unsub = form.registerComputedField("doubled", {
+        compute,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.doubled).toBe(10);
+
+      const countBeforeUnsub = compute.mock.calls.length;
+      unsub();
+
+      // Changing former dependency should NOT trigger the compute function
+      form.change("x", 99);
+      expect(compute.mock.calls.length).toBe(countBeforeUnsub);
+      expect(form.getState().values.doubled).toBeUndefined();
+    });
+
+    it("should not notify former field subscribers after unsubscribe on dependency change", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 3 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      const unsub = form.registerComputedField("doubled", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+
+      const fieldSub = jest.fn();
+      const unsubField = form.registerField("doubled", fieldSub, { value: true });
+      fieldSub.mockClear();
+
+      unsub();
+      // After cleanup, changing the former dependency must not notify the computed field's subscriber
+      form.change("x", 100);
+      expect(fieldSub).not.toHaveBeenCalled();
+      unsubField();
+    });
+
+    it("should handle multiple computed fields depending on the same source", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 4 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      form.registerComputedField("doubled", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+      form.registerComputedField("tripled", {
+        compute: (values) => (values.x || 0) * 3,
+        dependsOn: ["x"],
+      });
+      form.registerComputedField("squared", {
+        compute: (values) => (values.x || 0) * (values.x || 0),
+        dependsOn: ["x"],
+      });
+
+      expect(form.getState().values.doubled).toBe(8);
+      expect(form.getState().values.tripled).toBe(12);
+      expect(form.getState().values.squared).toBe(16);
+
+      form.change("x", 3);
+      expect(form.getState().values.doubled).toBe(6);
+      expect(form.getState().values.tripled).toBe(9);
+      expect(form.getState().values.squared).toBe(9);
+    });
+
+    it("should handle unregistering a computed field that others depend on", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 5 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      const unsubA = form.registerComputedField("a", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+      form.registerComputedField("b", {
+        compute: (values) => (values.a || 0) + 1,
+        dependsOn: ["a"],
+      });
+
+      expect(form.getState().values.b).toBe(11);
+
+      // Unregistering 'a' should cause 'b' to see undefined for 'a'
+      unsubA();
+      expect(form.getState().values.a).toBeUndefined();
+      expect(form.getState().values.b).toBe(1); // undefined + 1 via (0 + 1)
+    });
+
+    it("should work when computed field values is updated before subscribers fire", () => {
+      // This tests the critical requirement that computed values are in
+      // getState().values BEFORE any subscribers are notified
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 1 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      form.registerComputedField("doubled", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+
+      let valuesDuringNotification: any = null;
+      form.subscribe((state) => {
+        valuesDuringNotification = { ...state.values };
+      }, { values: true });
+
+      form.change("x", 5);
+      expect(valuesDuringNotification).not.toBeNull();
+      expect(valuesDuringNotification.doubled).toBe(10);
+    });
+
+    it("should handle re-registration of a computed field after unsubscribe", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 3 },
+      });
+      form.registerField("x", () => {}, { value: true });
+
+      const unsub1 = form.registerComputedField("comp", {
+        compute: (values) => (values.x || 0) + 100,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.comp).toBe(103);
+      unsub1();
+      expect(form.getState().values.comp).toBeUndefined();
+
+      // Re-register with a different compute function
+      form.registerComputedField("comp", {
+        compute: (values) => (values.x || 0) + 200,
+        dependsOn: ["x"],
+      });
+      expect(form.getState().values.comp).toBe(203);
+    });
+  });
+});
