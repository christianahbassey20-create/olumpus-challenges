+
+  // ─── Registration & Basic API ────────────────────────────────────────
+
+  describe("registerComputedField API", () => {
+    it("should expose registerComputedField on the form API", () => {
+      const form = createForm({ onSubmit: onSubmitMock });
+      expect(typeof form.registerComputedField).toBe("function");
+    });
+
+    it("should register a computed field and return an unsubscribe function", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { first: "John", last: "Doe" },
+      });
+      const unsub = form.registerComputedField("full", {
+        compute: (values) => `${values.first} ${values.last}`,
+        dependsOn: ["first", "last"],
+      });
+      expect(typeof unsub).toBe("function");
+    });
+
+    it("should make the computed field's value available in getState().values", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { a: 1, b: 2 },
+      });
+      form.registerComputedField("sum", {
+        compute: (values) => (values.a || 0) + (values.b || 0),
+        dependsOn: ["a", "b"],
+      });
+      expect(form.getState().values.sum).toBe(3);
+    });
+
+    it("should list computed fields in getRegisteredFields", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 10 },
+      });
+      form.registerField("x", () => {}, { value: true });
+      form.registerComputedField("doubled", {
+        compute: (values) => (values.x || 0) * 2,
+        dependsOn: ["x"],
+      });
+      const fields = form.getRegisteredFields();
+      expect(fields).toContain("x");
+      expect(fields).toContain("doubled");
+    });
+
+    it("should remove the computed field when unsubscribe is called", () => {
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 5 },
