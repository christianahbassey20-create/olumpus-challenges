+  // ─── Memoization ─────────────────────────────────────────────────────
+
+  describe("memoization", () => {
+    it("should not re-invoke compute if dependency values are referentially identical", () => {
+      const compute = jest.fn((values) => (values.x || 0) + 1);
+      const form = createForm({
+        onSubmit: onSubmitMock,
+        initialValues: { x: 10, y: 20 },
+      });
