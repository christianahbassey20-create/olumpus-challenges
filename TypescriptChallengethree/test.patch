+      form.registerField("x", () => {}, { value: true });
+      form.registerComputedField("neg", {
+        compute: (values) => -(values.x || 0),
+        dependsOn: ["x"],
+      });
+
+      const subscriber = jest.fn();
+      form.registerField("neg", subscriber, {
+        dirty: true,
+        pristine: true,
+        value: true,
