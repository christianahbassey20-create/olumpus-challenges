+@pytest.mark.django_db
+class TestBulkUpdate:
+    """Bulk update operations (PUT semantics)."""
+
+    def _create_events(self, count=3):
+        events = []
+        for i in range(count):
+            e = Event.objects.create(
+                title=f"BulkUpd{i}", start_date="2024-01-01", end_date="2024-01-02"
+            )
+            events.append(e)
+        return events
+
+    def test_bulk_update_success(self):
+        events = self._create_events(2)
+        client = TestClient(EventBulkAtomicController)
+        payload = [
+            {"id": events[0].id, "title": "Updated0", "start_date": "2025-01-01", "end_date": "2025-01-02"},
+            {"id": events[1].id, "title": "Updated1", "start_date": "2025-02-01", "end_date": "2025-02-02"},
+        ]
+        res = client.put("/bulk", json=payload)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["total"] == 2
+        assert body["succeeded"] == 2
+        assert body["failed"] == 0
+        for r in body["results"]:
+            assert r["status_code"] == 200
+            assert r["data"] is not None
+            assert isinstance(r["data"], dict)
+            assert "title" in r["data"]
+            assert r["errors"] is None
+        events[0].refresh_from_db()
+        events[1].refresh_from_db()
+        assert events[0].title == "Updated0"
+        assert events[1].title == "Updated1"
+
+    def test_bulk_update_atomic_rolls_back_on_not_found(self):
+        events = self._create_events(1)
+        client = TestClient(EventBulkAtomicController)
+        payload = [
+            {"id": events[0].id, "title": "ShouldRollback", "start_date": "2025-03-01", "end_date": "2025-03-02"},
+            {"id": 999999, "title": "NotExist", "start_date": "2025-04-01", "end_date": "2025-04-02"},
+        ]
+        res = client.put("/bulk", json=payload)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["succeeded"] == 0
+        assert body["failed"] == 2
+        events[0].refresh_from_db()
+        assert events[0].title != "ShouldRollback"
+
+    def test_bulk_update_non_atomic_partial_failure(self):
+        events = self._create_events(2)
+        client = TestClient(EventBulkNonAtomicController)
+        payload = [
+            {"id": events[0].id, "title": "PartialUpd", "start_date": "2025-05-01", "end_date": "2025-05-02"},
+            {"id": 999999, "title": "Ghost", "start_date": "2025-06-01", "end_date": "2025-06-02"},
+        ]
+        res = client.put("/bulk", json=payload)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["succeeded"] == 1
+        assert body["failed"] == 1
+        assert body["results"][0]["success"] is True
+        assert body["results"][0]["status_code"] == 200
+        assert body["results"][1]["success"] is False
+        assert body["results"][1]["status_code"] == 404
+        events[0].refresh_from_db()
+        assert events[0].title == "PartialUpd"
+
+    def test_bulk_update_max_items_enforced(self):
+        events = self._create_events(5)
+        client = TestClient(EventBulkAtomicController)
+        payload = [
+            {"id": e.id, "title": f"UpdMax{i}", "start_date": "2025-01-01", "end_date": "2025-01-02"}
+            for i, e in enumerate(events)
+        ]
+        # max_items=5, so 5 items should succeed
+        res = client.put("/bulk", json=payload)
+        assert res.status_code == 200
+        # Now try 6 items (exceeds max_items=5)
+        extra = Event.objects.create(title="Extra", start_date="2024-01-01", end_date="2024-01-02")
+        payload.append({"id": extra.id, "title": "UpdMax5", "start_date": "2025-01-01", "end_date": "2025-01-02"})
+        res = client.put("/bulk", json=payload)
+        assert res.status_code == 400
+
+
+@pytest.mark.django_db
+class TestBulkPatch:
+    """Bulk patch operations (partial update semantics)."""
+
+    def test_bulk_patch_partial_fields(self):
+        e1 = Event.objects.create(title="PatchMe1", start_date="2024-01-01", end_date="2024-01-02")
+        e2 = Event.objects.create(title="PatchMe2", start_date="2024-02-01", end_date="2024-02-02")
+        client = TestClient(EventBulkAtomicController)
+        payload = [
+            {"id": e1.id, "title": "Patched1"},
+            {"id": e2.id, "title": "Patched2"},
+        ]
+        res = client.patch("/bulk", json=payload)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["succeeded"] == 2
+        for r in body["results"]:
+            assert r["status_code"] == 200
+            assert r["data"] is not None
+            assert isinstance(r["data"], dict)
+            assert "title" in r["data"]
+            assert r["errors"] is None
+        e1.refresh_from_db()
+        e2.refresh_from_db()
+        assert e1.title == "Patched1"
+        assert e2.title == "Patched2"
+
+    def test_bulk_patch_non_atomic_partial_failure(self):
+        e1 = Event.objects.create(title="PatchOK", start_date="2024-03-01", end_date="2024-03-02")
+        client = TestClient(EventBulkNonAtomicController)
+        payload = [
+            {"id": e1.id, "title": "PatchedOK"},
+            {"id": 999999, "title": "PatchGhost"},
+        ]
+        res = client.patch("/bulk", json=payload)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["succeeded"] == 1
+        assert body["failed"] == 1
+        assert body["results"][1]["status_code"] == 404
+        e1.refresh_from_db()
+        assert e1.title == "PatchedOK"
+
+    def test_bulk_patch_max_items_enforced(self):
+        events = [Event.objects.create(title=f"PMax{i}", start_date="2024-01-01", end_date="2024-01-02") for i in range(6)]
+        client = TestClient(EventBulkAtomicController)
+        payload = [{"id": e.id, "title": f"PMaxUpd{i}"} for i, e in enumerate(events)]
+        res = client.patch("/bulk", json=payload)
+        assert res.status_code == 400
+
