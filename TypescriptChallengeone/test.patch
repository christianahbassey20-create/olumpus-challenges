+    def test_atomic_update_failure_results_cover_all_items(self):
+        """3 items: index 0 succeeds before rollback, index 1 fails (not found), index 2 skipped."""
+        e0 = Event.objects.create(title="AtShape0", start_date="2024-01-01", end_date="2024-01-02")
+        client = TestClient(EventBulkAtomicController)
+        payload = [
+            {"id": e0.id, "title": "Upd0", "start_date": "2025-01-01", "end_date": "2025-01-02"},
+            {"id": 999999, "title": "Ghost", "start_date": "2025-01-01", "end_date": "2025-01-02"},
+            {"id": e0.id, "title": "Upd2", "start_date": "2025-01-01", "end_date": "2025-01-02"},
+        ]
+        res = client.put("/bulk", json=payload)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["total"] == 3
+        assert body["succeeded"] == 0
+        assert body["failed"] == 3
+        assert len(body["results"]) == 3
+        # All results for update failure should use 404
+        for r in body["results"]:
+            assert r["status_code"] == 404
+        # Index 0 was rolled back
+        assert body["results"][0]["errors"] == "Rolled back"
+        # Index 1 is the failed item
+        assert body["results"][1]["success"] is False
+        # Index 2 was skipped (never processed)
+        assert body["results"][2]["errors"] == "Skipped"
+        # DB unchanged
+        e0.refresh_from_db()
+        assert e0.title == "AtShape0"
