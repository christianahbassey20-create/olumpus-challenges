+#!/usr/bin/env bash
+set -euo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    *)
+      MODE="$1"
+      shift
+      ;;
+  esac
+done
+
+MODE="${MODE:-new}"
+PYTEST_ARGS=(-x --tb=short)
+if [ -n "$OUTPUT_PATH" ]; then
+  PYTEST_ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+if [ "$MODE" = "base" ]; then
+  python -m pytest "${PYTEST_ARGS[@]}" --ignore=tests/test_model_controller/test_bulk_operations.py
+elif [ "$MODE" = "new" ]; then
+  python -m pytest "${PYTEST_ARGS[@]}" tests/test_model_controller/test_bulk_operations.py
+else
+  echo "Usage: $0 [--output_path <path>] [base|new]" >&2
+  exit 1
+fi
