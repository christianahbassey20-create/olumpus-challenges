+@pytest.mark.django_db
+class TestBulkCreateAtomic:
+    """Bulk create with atomic=True: all-or-nothing semantics."""
+
+    def test_bulk_create_success_returns_response_shape(self):
+        client = TestClient(EventBulkAtomicController)
+        items = [
+            {"title": "E1", "start_date": "2024-01-01", "end_date": "2024-01-02"},
+            {"title": "E2", "start_date": "2024-02-01", "end_date": "2024-02-02"},
+        ]
+        res = client.post("/bulk", json=items)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["total"] == 2
+        assert body["succeeded"] == 2
+        assert body["failed"] == 0
+        assert len(body["results"]) == 2
+        for i, r in enumerate(body["results"]):
+            assert r["index"] == i
+            assert r["success"] is True
+            assert r["status_code"] == 201
+
+    def test_bulk_create_items_persisted_in_db(self):
+        client = TestClient(EventBulkAtomicController)
+        items = [
+            {"title": "Persisted1", "start_date": "2024-03-01", "end_date": "2024-03-02"},
+            {"title": "Persisted2", "start_date": "2024-04-01", "end_date": "2024-04-02"},
+        ]
+        res = client.post("/bulk", json=items)
+        assert res.status_code == 200
+        assert Event.objects.filter(title="Persisted1").exists()
+        assert Event.objects.filter(title="Persisted2").exists()
+
+    def test_bulk_create_invalid_item_rejects_entire_request(self):
+        """A schema-invalid item in the list causes pydantic to reject the whole request."""
+        client = TestClient(EventBulkAtomicController)
+        items = [
+            {"title": "GoodItem", "start_date": "2024-05-01", "end_date": "2024-05-02"},
+            {"title": "X" * 200, "start_date": "2024-06-01", "end_date": "2024-06-02"},
+        ]
+        res = client.post("/bulk", json=items)
+        assert res.status_code == 422
+        assert not Event.objects.filter(title="GoodItem").exists()
+
+    def test_bulk_create_max_items_enforced(self):
+        client = TestClient(EventBulkAtomicController)
+        items = [
+            {"title": f"Item{i}", "start_date": "2024-01-01", "end_date": "2024-01-02"}
+            for i in range(6)
+        ]
+        res = client.post("/bulk", json=items)
+        assert res.status_code == 400
+
+    def test_bulk_create_empty_list(self):
+        client = TestClient(EventBulkAtomicController)
+        res = client.post("/bulk", json=[])
+        assert res.status_code == 200
+        body = res.json()
+        assert body["total"] == 0
+        assert body["succeeded"] == 0
+        assert body["failed"] == 0
+        assert body["results"] == []
+
