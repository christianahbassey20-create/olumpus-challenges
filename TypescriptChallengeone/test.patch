+@pytest.mark.django_db(transaction=True)
+class TestBulkAsync:
+    """Async bulk operations."""
+
+    @pytest.mark.asyncio
+    async def test_async_bulk_create(self):
+        client = TestAsyncClient(EventBulkAsyncController)
+        items = [
+            {"title": "Async1", "start_date": "2024-01-01", "end_date": "2024-01-02"},
+            {"title": "Async2", "start_date": "2024-02-01", "end_date": "2024-02-02"},
+        ]
+        res = await client.post("/bulk", json=items)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["total"] == 2
+        assert body["succeeded"] == 2
+        assert body["failed"] == 0
+
+    @pytest.mark.asyncio
+    async def test_async_bulk_update(self):
+        from asgiref.sync import sync_to_async
+        e1 = await sync_to_async(Event.objects.create)(
+            title="AsyncUpd1", start_date="2024-01-01", end_date="2024-01-02"
+        )
+        client = TestAsyncClient(EventBulkAsyncController)
+        payload = [{"id": e1.id, "title": "AsyncUpdated1", "start_date": "2025-01-01", "end_date": "2025-01-02"}]
+        res = await client.put("/bulk", json=payload)
+        assert res.status_code == 200
