+   * @returns {Promise<NavigateToResult>} The navigation result.
+   */
+  async navigateTo(
+    target: MatchTarget,
+    options?: NavigateToOptions
+  ): Promise<NavigateToResult> {
+    if (!this.#started) {
+      throw new Error(ERR_NVDA_NOT_RUNNING);
+    }
+
+    const direction = options?.direction ?? "next";
+    const maxSteps = options?.maxSteps ?? 100;
+    const elementType = options?.elementType;
+
+    let navigationKeyCommand: KeyCodeCommand;
+
+    if (elementType) {
+      const command = getNVDANavigationCommand(elementType, direction);
+
+      if (!command) {
+        throw new Error(`Unsupported element type for NVDA: ${elementType}`);
+      }
+
+      navigationKeyCommand = command;
+    } else {
+      navigationKeyCommand =
+        direction === "previous"
+          ? keyCodeCommands.moveToPrevious
+          : keyCodeCommands.moveToNext;
+    }
+
+    const initialPhrase = await this.lastSpokenPhrase();
+    const visited: string[] = [];
+
+    for (let step = 0; step < maxSteps; step++) {
+      await this.#client.waitForSpokenPhrase(
+        () => this.#client.sendKeyCode(navigationKeyCommand),
+        options
+      );
+
+      const phrase = await this.lastSpokenPhrase();
+
+      visited.push(phrase);
+
+      if (matchPattern(target, phrase)) {
+        return { found: true, phrase, steps: step + 1, visited };
+      }
+
+      if (phrase === initialPhrase) {
+        return { found: false, phrase: "", steps: step + 1, visited };
+      }
+    }
+
+    return { found: false, phrase: "", steps: maxSteps, visited };
+  }
 }
