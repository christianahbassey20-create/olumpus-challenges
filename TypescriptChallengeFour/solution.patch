+  /**
+   * [API Reference](https://www.guidepup.dev/docs/api/class-voiceover#voiceover-navigate-to)
+   *
+   * Navigate through items until finding one whose spoken phrase or item text
+   * matches the target pattern.
+   *
+   * ```ts
+   * import { voiceOver } from "@guidepup/guidepup";
+   *
+   * (async () => {
+   *   // Start VoiceOver.
+   *   await voiceOver.start();
+   *
+   *   // Navigate to the next heading containing "Main".
+   *   const result = await voiceOver.navigateTo("Main", {
+   *     elementType: "heading",
+   *   });
+   *
+   *   console.log(result.found);   // true
+   *   console.log(result.phrase);  // "heading level 1, Main Title"
+   *   console.log(result.steps);   // 2
+   *   console.log(result.visited); // ["heading level 2, Nav", "heading level 1, Main Title"]
+   *
+   *   // Stop VoiceOver.
+   *   await voiceOver.stop();
+   * })();
+   * ```
+   *
+   * @param {MatchTarget} target String (case-insensitive substring), RegExp,
+   *   or predicate function to match against.
+   * @param {NavigateToOptions} [options] Additional navigation options.
+   * @returns {Promise<NavigateToResult>} The navigation result.
+   */
+  async navigateTo(
+    target: MatchTarget,
+    options?: NavigateToOptions
+  ): Promise<NavigateToResult> {
+    if (!this.#started) {
+      throw new Error(ERR_VOICE_OVER_NOT_RUNNING);
+    }
+
+    const direction = options?.direction ?? "next";
+    const maxSteps = options?.maxSteps ?? 100;
+    const matchMode = options?.match ?? "spokenPhrase";
+    const elementType = options?.elementType;
+
+    if (elementType) {
+      const command = getVoiceOverNavigationCommand(elementType, direction);
+
+      if (!command) {
+        throw new Error(
+          `Unsupported element type for VoiceOver: ${elementType}`
+        );
+      }
+    }
+
+    const initialPhrase =
+      matchMode === "itemText"
+        ? await this.#caption.itemText()
+        : await this.#caption.lastSpokenPhrase();
+
+    const visited: string[] = [];
+
+    for (let step = 0; step < maxSteps; step++) {
+      if (elementType) {
+        const command = getVoiceOverNavigationCommand(elementType, direction);
+
+        await this.#keyboard.perform(command, options);
+      } else if (direction === "previous") {
+        await this.#cursor.previous(options);
+      } else {
+        await this.#cursor.next(options);
+      }
+
+      const phrase =
+        matchMode === "itemText"
+          ? await this.#caption.itemText()
+          : await this.#caption.lastSpokenPhrase();
+
+      visited.push(phrase);
+
+      if (matchPattern(target, phrase)) {
+        return { found: true, phrase, steps: step + 1, visited };
+      }
+
+      if (phrase === initialPhrase) {
+        return { found: false, phrase: "", steps: step + 1, visited };
+      }
+    }
+
+    return { found: false, phrase: "", steps: maxSteps, visited };
+  }
 }
