@@ -0,0 +1,35 @@
+import type { CommandOptions } from "./CommandOptions";
+
+/**
+ * Options for the `navigateTo` method on screen readers.
+ */
+export interface NavigateToOptions extends CommandOptions {
+  /**
+   * Direction to navigate. Default is `"next"`.
+   */
+  direction?: "next" | "previous";
+
+  /**
+   * Maximum number of navigation steps before giving up. Default is `100`.
+   */
+  maxSteps?: number;
+
+  /**
+   * Which text to compare against the target pattern.
+   *
+   * - `"spokenPhrase"` (default): compare against the spoken phrase.
+   * - `"itemText"`: compare against the item text.
+   */
+  match?: "spokenPhrase" | "itemText";
+
+  /**
+   * Navigate by element kind using the platform's native element navigation
+   * commands. Examples: `"heading"`, `"link"`, `"table"`, `"list"`,
+   * `"graphic"`.
+   *
+   * When not specified, generic next/previous navigation is used.
+   *
+   * Unsupported element types will throw an error.
+   */
+  elementType?: string;
+}
