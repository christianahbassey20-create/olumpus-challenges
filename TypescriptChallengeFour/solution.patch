+import { keyCodeCommands } from "./keyCodeCommands";
+import type { KeyCodeCommand } from "../KeyCodeCommand";
+
+type NavigationPair = {
+  next: KeyCodeCommand;
+  previous: KeyCodeCommand;
+};
+
+const elementCommands: Record<string, NavigationPair> = {
+  heading: {
+    next: keyCodeCommands.findNextHeading,
+    previous: keyCodeCommands.findPreviousHeading,
+  },
+  link: {
+    next: keyCodeCommands.findNextLink,
+    previous: keyCodeCommands.findPreviousLink,
+  },
+  table: {
+    next: keyCodeCommands.findNextTable,
+    previous: keyCodeCommands.findPreviousTable,
+  },
+  list: {
+    next: keyCodeCommands.findNextList,
+    previous: keyCodeCommands.findPreviousList,
+  },
+  graphic: {
+    next: keyCodeCommands.findNextGraphic,
+    previous: keyCodeCommands.findPreviousGraphic,
+  },
+  visitedLink: {
+    next: keyCodeCommands.findNextVisitedLink,
+    previous: keyCodeCommands.findPreviousVisitedLink,
+  },
+  control: {
+    next: keyCodeCommands.findNextControl,
+    previous: keyCodeCommands.findPreviousControl,
+  },
+  boldText: {
+    next: keyCodeCommands.findNextBoldText,
+    previous: keyCodeCommands.findPreviousBoldText,
+  },
+  italicText: {
+    next: keyCodeCommands.findNextItalicText,
+    previous: keyCodeCommands.findPreviousItalicText,
+  },
+  underlinedText: {
+    next: keyCodeCommands.findNextUnderlinedText,
+    previous: keyCodeCommands.findPreviousUnderlinedText,
+  },
+  plainText: {
+    next: keyCodeCommands.findNextPlainText,
+    previous: keyCodeCommands.findPreviousPlainText,
+  },
+  styleChange: {
+    next: keyCodeCommands.findNextStyleChange,
+    previous: keyCodeCommands.findPreviousStyleChange,
+  },
+  colorChange: {
+    next: keyCodeCommands.findNextColorChange,
+    previous: keyCodeCommands.findPreviousColorChange,
+  },
+  fontChange: {
+    next: keyCodeCommands.findNextFontChange,
+    previous: keyCodeCommands.findPreviousFontChange,
+  },
+  misspelledWord: {
+    next: keyCodeCommands.findNextMisspelledWord,
+    previous: keyCodeCommands.findPreviousMisspelledWord,
+  },
+  headingOfSameLevel: {
+    next: keyCodeCommands.findNextHeadingOfSameLevel,
+    previous: keyCodeCommands.findPreviousHeadingOfSameLevel,
+  },
+  differentItem: {
+    next: keyCodeCommands.findNextDifferentItem,
+    previous: keyCodeCommands.findPreviousDifferentItem,
+  },
+  sameTypeItem: {
+    next: keyCodeCommands.findNextItemWithSameTypeAsCurrentItem,
+    previous: keyCodeCommands.findPreviousItemWithSameTypeAsCurrentItem,
+  },
+};
+
+/**
+ * Get the VoiceOver keyboard command for navigating to the next or previous
+ * element of the specified type.
+ *
+ * @param elementType The element type to navigate by.
+ * @param direction   The navigation direction.
+ * @returns The keyboard command, or `null` if the element type is not supported.
+ */
+export function getVoiceOverNavigationCommand(
+  elementType: string,
+  direction: "next" | "previous"
+): KeyCodeCommand | null {
+  const pair = elementCommands[elementType];
+
+  if (!pair) {
+    return null;
+  }
+
+  return pair[direction];
+}
