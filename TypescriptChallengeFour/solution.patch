@@ -0,0 +1,44 @@
+/**
+ * Target for pattern matching in navigation operations.
+ *
+ * - `string`: case-insensitive substring matching
+ * - `RegExp`: regular expression matching
+ * - `function`: predicate receiving phrase text, returning boolean
+ */
+export type MatchTarget = string | RegExp | ((text: string) => boolean);
+
+/**
+ * Test whether `text` matches the given `target` pattern.
+ *
+ * - **string** targets use case-insensitive substring matching.
+ * - **RegExp** targets test the full text against the pattern.
+ * - **function** targets receive the text and must return a boolean;
+ *   predicates that throw are treated as non-matching.
+ *
+ * @param target The match target.
+ * @param text   The text to test.
+ * @returns Whether the text matches the target.
+ */
+export function matchPattern(target: MatchTarget, text: string): boolean {
+  if (typeof target === "string") {
+    if (target === "") {
+      return true;
+    }
+
+    return text.toLowerCase().includes(target.toLowerCase());
+  }
+
+  if (target instanceof RegExp) {
+    return target.test(text);
+  }
+
+  if (typeof target === "function") {
+    try {
+      return Boolean(target(text));
+    } catch {
+      return false;
+    }
+  }
+
+  return false;
+}
