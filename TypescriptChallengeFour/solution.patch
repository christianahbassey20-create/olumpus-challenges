+   *   await nvda.start();
+   *
+   *   // Navigate to the next heading containing "Main".
+   *   const result = await nvda.navigateTo("Main", {
+   *     elementType: "heading",
+   *   });
+   *
+   *   console.log(result.found);   // true
+   *   console.log(result.phrase);  // "heading level 1, Main Title"
+   *   console.log(result.steps);   // 2
+   *   console.log(result.visited); // ["Nav", "heading level 1, Main Title"]
+   *
+   *   // Stop NVDA.
+   *   await nvda.stop();
+   * })();
+   * ```
+   *
+   * @param {MatchTarget} target String (case-insensitive substring), RegExp,
+   *   or predicate function to match against.
