@@ -0,0 +1,24 @@
+/**
+ * Result of a `navigateTo` operation.
+ */
+export interface NavigateToResult {
+  /**
+   * Whether a matching item was found.
+   */
+  found: boolean;
+
+  /**
+   * The matched phrase text, or an empty string if no match was found.
+   */
+  phrase: string;
+
+  /**
+   * The number of navigation steps performed.
+   */
+  steps: number;
+
+  /**
+   * All phrases encountered during navigation, in order.
+   */
+  visited: string[];
+}
