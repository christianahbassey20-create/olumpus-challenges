+#!/usr/bin/env bash
+set -euo pipefail
+
+MODE="${1:-new}"
+shift || true
+
+OUTPUT_PATH=""
+while [[ $# -gt 0 ]]; do
+  case $1 in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    *)
+      shift
+      ;;
+  esac
+done
+
+JEST_ARGS="--no-coverage --forceExit"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  JEST_JUNIT_OUTPUT_DIR="$(dirname "$OUTPUT_PATH")"
+  JEST_JUNIT_OUTPUT_NAME="$(basename "$OUTPUT_PATH")"
+  export JEST_JUNIT_OUTPUT_DIR
+  export JEST_JUNIT_OUTPUT_NAME
+  JEST_ARGS="$JEST_ARGS --reporters=default --reporters=jest-junit"
+fi
+
+if [ "$MODE" = "base" ]; then
+  npx jest $JEST_ARGS \
+    --testPathIgnorePatterns="navigateTo\\.test\\.ts" \
+    --testPathIgnorePatterns="matchPattern\\.test\\.ts"
+elif [ "$MODE" = "new" ]; then
+  npx jest $JEST_ARGS \
+    --testPathPattern="(navigateTo|matchPattern)\\.test\\.ts"
+else
+  echo "Usage: $0 [base|new] [--output_path <path>]" >&2
+  exit 1
+fi
