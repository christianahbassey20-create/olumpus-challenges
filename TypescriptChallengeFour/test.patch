+
+      it("should treat a throwing predicate as non-matching and continue", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Item 1")
+          .mockResolvedValueOnce("Item 2")
+          .mockResolvedValueOnce("Start");
+
+        const result = await vo.navigateTo(() => {
+          throw new Error("boom");
+        });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(3);
+      });
+    });
+
+    describe("elementType navigation", () => {
+      it("should navigate by heading element type using keyboard perform", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("heading level 1, Main Title");
+
+        const result = await vo.navigateTo("Main", {
+          elementType: "heading",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 1, Main Title");
+        expect(VoiceOverKeyboardStub.perform).toHaveBeenCalled();
+        expect(VoiceOverCursorStub.next).not.toHaveBeenCalled();
+      });
+
+      it("should navigate by link element type", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Skip navigation link")
+          .mockResolvedValueOnce("Home link");
+
+        const result = await vo.navigateTo("Home", {
+          elementType: "link",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.steps).toBe(2);
+      });
+
+      it("should navigate by element type in previous direction", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("heading level 2, Previous Section");
+
+        const result = await vo.navigateTo("Previous", {
+          elementType: "heading",
+          direction: "previous",
+        });
+
+        expect(result.found).toBe(true);
+        expect(VoiceOverKeyboardStub.perform).toHaveBeenCalled();
+      });
+
+      it("should throw error for unsupported element type containing the type name", async () => {
+        await expect(
+          vo.navigateTo("text", { elementType: "landmark" } as any)
+        ).rejects.toThrow("landmark");
+      });
+
+      it("should support element type with cycle detection", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("heading level 1, Title")
+          .mockResolvedValueOnce("heading level 2, Subtitle")
+          .mockResolvedValueOnce("heading level 1, Title");
+
+        const result = await vo.navigateTo("nonexistent", {
+          elementType: "heading",
+        });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(2);
+      });
+    });
+
+    describe("cycle detection", () => {
+      it("should detect cycle when first step returns to start", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Only Item")
+          .mockResolvedValueOnce("Only Item");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(1);
+        expect(result.visited).toStrictEqual(["Only Item"]);
+      });
+
+      it("should detect cycle after multiple steps", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Item A")
+          .mockResolvedValueOnce("Item B")
+          .mockResolvedValueOnce("Start");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result).toStrictEqual({
+          found: false,
+          phrase: "",
+          steps: 3,
+          visited: ["Item A", "Item B", "Start"],
+        });
+      });
+
+      it("should handle empty initial phrase for cycle detection", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("")
+          .mockResolvedValueOnce("Item 1")
+          .mockResolvedValueOnce("Item 2")
+          .mockResolvedValueOnce("");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(3);
+      });
+    });
+
+    describe("visited array", () => {
+      it("should include all phrases from every step in order", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Alpha")
+          .mockResolvedValueOnce("Beta")
+          .mockResolvedValueOnce("Gamma")
+          .mockResolvedValueOnce("Start");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result.visited).toStrictEqual([
+          "Alpha",
+          "Beta",
+          "Gamma",
+          "Start",
+        ]);
+        expect(result.steps).toBe(4);
+      });
+
+      it("should not include the initial position phrase in visited", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Initial")
+          .mockResolvedValueOnce("Found");
+
+        const result = await vo.navigateTo("Found");
+
+        expect(result.visited).toStrictEqual(["Found"]);
+      });
+    });
+  });
+});
