+
+      it("should record element type navigation steps in both logs", async () => {
+        const spokenLog: string[] = [];
+        const itemLog: string[] = [];
+        const navPhrases = ["heading A", "heading Found"];
+        let navIdx = 0;
+
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("heading A")
+          .mockResolvedValueOnce("heading Found");
+
+        VoiceOverKeyboardStub.perform.mockImplementation(async () => {
+          spokenLog.push(navPhrases[navIdx]);
+          itemLog.push(navPhrases[navIdx]);
+          navIdx++;
+        });
+
+        VoiceOverCaptionStub.spokenPhraseLog.mockImplementation(
+          async () => [...spokenLog]
+        );
+        VoiceOverCaptionStub.itemTextLog.mockImplementation(
+          async () => [...itemLog]
+        );
+
+        await vo.navigateTo("Found", { elementType: "heading" });
+
+        const sLog = await VoiceOverCaptionStub.spokenPhraseLog();
+        expect(sLog).toStrictEqual(["heading A", "heading Found"]);
+
+        const iLog = await VoiceOverCaptionStub.itemTextLog();
+        expect(iLog).toStrictEqual(["heading A", "heading Found"]);
+      });
+    });
+  });
+});
