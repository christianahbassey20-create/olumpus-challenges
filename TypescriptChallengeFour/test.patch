+import type { MatchTarget, NavigateToOptions, NavigateToResult } from "./index";
+
+describe("package entry point type exports", () => {
+  it("should export NavigateToOptions with direction option", () => {
+    const opts: NavigateToOptions = { direction: "next" };
+    expect(opts.direction).toBe("next");
+  });
+
+  it("should export NavigateToOptions with all options", () => {
+    const opts: NavigateToOptions = {
+      direction: "previous",
+      maxSteps: 50,
+      match: "itemText",
+      elementType: "heading",
+    };
+    expect(opts.direction).toBe("previous");
+    expect(opts.maxSteps).toBe(50);
+    expect(opts.match).toBe("itemText");
+    expect(opts.elementType).toBe("heading");
+  });
+
+  it("should export NavigateToOptions with all fields optional", () => {
+    const opts: NavigateToOptions = {};
+    expect(opts).toStrictEqual({});
+  });
+
+  it("should export NavigateToResult with expected properties", () => {
+    const result: NavigateToResult = {
+      found: true,
+      phrase: "matched phrase",
+      steps: 3,
+      visited: ["a", "b", "matched phrase"],
+    };
+    expect(result.found).toBe(true);
+    expect(result.phrase).toBe("matched phrase");
+    expect(result.steps).toBe(3);
+    expect(result.visited).toHaveLength(3);
+  });
+
+  it("should export NavigateToResult for not-found case", () => {
+    const result: NavigateToResult = {
+      found: false,
+      phrase: "",
+      steps: 10,
+      visited: ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"],
+    };
+    expect(result.found).toBe(false);
+    expect(result.phrase).toBe("");
+    expect(result.steps).toBe(10);
+  });
+
+  it("should export MatchTarget accepting a string", () => {
+    const target: MatchTarget = "heading";
+    expect(typeof target).toBe("string");
+  });
+
+  it("should export MatchTarget accepting a RegExp", () => {
+    const target: MatchTarget = /heading level \d/i;
+    expect(target).toBeInstanceOf(RegExp);
+  });
+
+  it("should export MatchTarget accepting a predicate function", () => {
+    const target: MatchTarget = (text: string) => text.length > 10;
+    expect(typeof target).toBe("function");
+    expect(target("short")).toBe(false);
+    expect(target("a long enough string")).toBe(true);
+  });
+});
