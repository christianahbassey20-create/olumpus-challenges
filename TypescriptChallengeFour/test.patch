+import {
+  ERR_NVDA_NOT_RUNNING,
+} from "../errors";
+import { isNVDAInstalled } from "./isNVDAInstalled";
+import { isWindows } from "../isWindows";
+import { NVDA } from "./NVDA";
+import { NVDAClient } from "./NVDAClient";
+import { start } from "./start";
+import { quit } from "./quit";
+
+jest.mock("./NVDAClient", () => ({
+  NVDAClient: jest.fn(),
+}));
+jest.mock("./start", () => ({
+  start: jest.fn(),
+}));
+jest.mock("./quit", () => ({
+  quit: jest.fn(),
+}));
+jest.mock("./isNVDAInstalled", () => ({
+  isNVDAInstalled: jest.fn(),
+}));
+jest.mock("../isWindows", () => ({
+  isWindows: jest.fn(),
+}));
+jest.mock("../sendKeys", () => ({
+  sendKeys: jest.fn(),
+}));
+
+const NVDAClientStub = {
+  connect: jest.fn(),
+  disconnect: jest.fn(),
+  spokenPhraseLog: jest.fn(),
+  clearSpokenPhraseLog: jest.fn(),
+  sendKeyCode: jest.fn(),
+  waitForSpokenPhrase: jest.fn(),
+  addListener: jest.fn(),
+  removeListener: jest.fn(),
+  once: jest.fn(),
+  emit: jest.fn(),
+  on: jest.fn(),
+};
+
+describe("NVDA navigateTo", () => {
+  let nvda: NVDA;
+
+  beforeEach(() => {
+    jest.resetAllMocks();
+    jest.clearAllMocks();
+
+    jest.mocked(isWindows).mockReturnValue(true);
+    jest.mocked(isNVDAInstalled).mockResolvedValue(true);
+    (NVDAClient as unknown as jest.Mock).mockImplementation(
+      () => NVDAClientStub
+    );
+
+    nvda = new NVDA();
+  });
+
+  describe("when NVDA is not running", () => {
+    it("should throw an error", async () => {
+      await expect(nvda.navigateTo("target")).rejects.toThrow(
+        ERR_NVDA_NOT_RUNNING
+      );
+    });
+  });
+
+  describe("when NVDA is running", () => {
+    let capturedPhrases: string[];
+    let phraseQueue: string[];
+
+    function setUpPhrases(initial: string[], navigation: string[]) {
+      capturedPhrases = [...initial];
+      phraseQueue = [...navigation];
+      NVDAClientStub.spokenPhraseLog.mockImplementation(() =>
+        Promise.resolve([...capturedPhrases])
+      );
+    }
+
+    beforeEach(async () => {
+      capturedPhrases = [];
+      phraseQueue = [];
+
+      NVDAClientStub.waitForSpokenPhrase.mockImplementation(
+        async (action: () => Promise<unknown>) => {
+          await action();
+          const phrase = phraseQueue.shift() ?? "";
+          capturedPhrases.push(phrase);
+        }
+      );
+
+      NVDAClientStub.spokenPhraseLog.mockImplementation(() =>
+        Promise.resolve([...capturedPhrases])
+      );
+
+      await nvda.start();
+    });
+
+    describe("string target matching", () => {
+      it("should find matching item on the first step", async () => {
+        setUpPhrases(["Start"], ["Target Found"]);
+
+        const result = await nvda.navigateTo("target");
+
+        expect(result).toStrictEqual({
+          found: true,
+          phrase: "Target Found",
+          steps: 1,
+          visited: ["Target Found"],
+        });
+      });
+
+      it("should find matching item after multiple steps", async () => {
+        setUpPhrases(["Start"], ["Item 1", "Item 2", "Target Found"]);
+
+        const result = await nvda.navigateTo("target");
+
+        expect(result).toStrictEqual({
+          found: true,
+          phrase: "Target Found",
+          steps: 3,
+          visited: ["Item 1", "Item 2", "Target Found"],
+        });
+      });
+
+      it("should perform case-insensitive substring matching", async () => {
+        setUpPhrases(["Initial"], ["NAVIGATION HEADING"]);
+
+        const result = await nvda.navigateTo("navigation");
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("NAVIGATION HEADING");
+      });
+
+      it("should detect cycle when returning to initial phrase", async () => {
+        setUpPhrases(["Start"], ["Item A", "Item B", "Start"]);
+
+        const result = await nvda.navigateTo("nonexistent");
+
+        expect(result).toStrictEqual({
+          found: false,
+          phrase: "",
+          steps: 3,
+          visited: ["Item A", "Item B", "Start"],
+        });
+      });
+
+      it("should not treat repeated non-initial phrases as cycle", async () => {
+        setUpPhrases(["Start"], ["Same", "Same", "Target"]);
+
+        const result = await nvda.navigateTo("Target");
+
+        expect(result.found).toBe(true);
+        expect(result.steps).toBe(3);
+        expect(result.visited).toStrictEqual(["Same", "Same", "Target"]);
+      });
+    });
+
+    describe("maxSteps option", () => {
+      it("should stop at maxSteps when no match is found", async () => {
+        setUpPhrases(["Start"], ["A", "B", "C", "D", "E"]);
+
+        const result = await nvda.navigateTo("nonexistent", { maxSteps: 3 });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(3);
+        expect(result.visited).toStrictEqual(["A", "B", "C"]);
+      });
+
+      it("should default to 100 maxSteps", async () => {
+        const manyPhrases = Array.from(
+          { length: 100 },
+          (_, i) => `Item ${i}`
+        );
+        setUpPhrases(["Start"], manyPhrases);
+
+        const result = await nvda.navigateTo("nonexistent");
+
+        expect(result.steps).toBe(100);
+      });
+    });
+
+    describe("direction option", () => {
+      it("should navigate backward with previous direction", async () => {
+        setUpPhrases(["Current"], ["Previous Target"]);
+
+        const result = await nvda.navigateTo("Previous", {
+          direction: "previous",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("Previous Target");
+        expect(result.steps).toBe(1);
+      });
+
+      it("should navigate forward by default", async () => {
+        setUpPhrases(["Start"], ["Next Item"]);
+
+        const result = await nvda.navigateTo("Next");
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("Next Item");
+        expect(result.steps).toBe(1);
+      });
+    });
+
+    describe("RegExp target", () => {
+      it("should find item matching regex", async () => {
+        setUpPhrases(
+          ["Start"],
+          ["text field", "heading level 2, About Us"]
+        );
+
+        const result = await nvda.navigateTo(/^heading level/);
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 2, About Us");
+        expect(result.steps).toBe(2);
+      });
+
+      it("should return not found when regex never matches", async () => {
+        setUpPhrases(["Start"], ["Item", "Start"]);
+
+        const result = await nvda.navigateTo(/^zzz$/);
+
+        expect(result.found).toBe(false);
+      });
+    });
+
+    describe("predicate target", () => {
+      it("should find item matching predicate", async () => {
+        setUpPhrases(
+          ["Start"],
+          ["Short", "This is a long enough phrase to match the predicate"]
+        );
+
+        const result = await nvda.navigateTo((text) => text.length > 20);
+
+        expect(result.found).toBe(true);
+        expect(result.steps).toBe(2);
+      });
+
+      it("should handle throwing predicate gracefully", async () => {
+        setUpPhrases(["Start"], ["Item", "Start"]);
+
+        const result = await nvda.navigateTo(() => {
+          throw new Error("error");
+        });
+
+        expect(result.found).toBe(false);
+      });
+    });
+
+    describe("elementType navigation", () => {
+      it("should navigate by heading type", async () => {
+        setUpPhrases(["Start"], ["heading level 1, Title"]);
+
+        const result = await nvda.navigateTo("Title", {
+          elementType: "heading",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 1, Title");
+      });
+
+      it("should navigate by button type (NVDA-specific)", async () => {
+        setUpPhrases(["Start"], ["Submit button"]);
+
+        const result = await nvda.navigateTo("Submit", {
+          elementType: "button",
+        });
+
+        expect(result.found).toBe(true);
+      });
+
+      it("should navigate by landmark type (NVDA-specific)", async () => {
+        setUpPhrases(["Start"], ["main landmark"]);
+
+        const result = await nvda.navigateTo("main", {
+          elementType: "landmark",
+        });
+
+        expect(result.found).toBe(true);
+      });
+
+      it("should throw error for unsupported element type containing the type name", async () => {
+        await expect(
+          nvda.navigateTo("text", { elementType: "boldText" } as any)
+        ).rejects.toThrow("boldText");
+      });
+
+      it("should combine element type with previous direction", async () => {
+        setUpPhrases(["Start"], ["heading level 3, Previous Section"]);
+
+        const result = await nvda.navigateTo("Previous", {
+          elementType: "heading",
+          direction: "previous",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 3, Previous Section");
+      });
+
+      it("should apply cycle detection with element type navigation", async () => {
+        setUpPhrases(
+          ["heading level 1, Title"],
+          ["heading level 2, Sub", "heading level 1, Title"]
+        );
+
+        const result = await nvda.navigateTo("nonexistent", {
+          elementType: "heading",
+        });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(2);
+      });
+    });
+
+    describe("cycle detection edge cases", () => {
+      it("should detect single-item cycle", async () => {
+        setUpPhrases(["Only Item"], ["Only Item"]);
+
+        const result = await nvda.navigateTo("nonexistent");
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(1);
+      });
+
+      it("should handle empty initial phrase for cycle detection", async () => {
+        setUpPhrases([], ["Item 1", "Item 2", ""]);
+
+        const result = await nvda.navigateTo("nonexistent");
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(3);
+      });
+    });
+
+    describe("visited array correctness", () => {
+      it("should contain all visited phrases in order", async () => {
+        setUpPhrases(["Start"], ["Alpha", "Beta", "Gamma", "Start"]);
+
+        const result = await nvda.navigateTo("nonexistent");
+
+        expect(result.visited).toStrictEqual([
+          "Alpha",
+          "Beta",
+          "Gamma",
+          "Start",
+        ]);
+      });
+
+      it("should not include initial phrase in visited array", async () => {
+        setUpPhrases(["Initial"], ["Found"]);
+
+        const result = await nvda.navigateTo("Found");
+
+        expect(result.visited).toStrictEqual(["Found"]);
+      });
+    });
+
+    describe("logging parity with next/previous", () => {
+      it("should accumulate spokenPhraseLog entries identically to sequential next calls", async () => {
+        setUpPhrases(["Start"], ["Step 1", "Step 2", "Target"]);
+
+        const result = await nvda.navigateTo("Target");
+
+        const log = await NVDAClientStub.spokenPhraseLog();
+        expect(log).toStrictEqual(["Start", "Step 1", "Step 2", "Target"]);
+        expect(result.visited).toStrictEqual(["Step 1", "Step 2", "Target"]);
+      });
+
+      it("should accumulate spokenPhraseLog entries for backward navigation", async () => {
+        setUpPhrases(["Current"], ["Prev 1", "Found"]);
+
+        const result = await nvda.navigateTo("Found", { direction: "previous" });
+
+        expect(result.steps).toBe(2);
+        const log = await NVDAClientStub.spokenPhraseLog();
+        expect(log).toStrictEqual(["Current", "Prev 1", "Found"]);
+      });
+    });
+  });
+});
