+
+  describe("when VoiceOver is not running", () => {
+    it("should throw an error", async () => {
+      await expect(vo.navigateTo("target")).rejects.toThrow(
+        ERR_VOICE_OVER_NOT_RUNNING
+      );
+    });
+  });
+
+  describe("when VoiceOver is running", () => {
+    beforeEach(async () => {
+      await vo.start();
+    });
+
+    describe("string target matching", () => {
+      it("should find matching item on the first step", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Target Item");
+
+        const result = await vo.navigateTo("target");
+
+        expect(result).toStrictEqual({
+          found: true,
+          phrase: "Target Item",
+          steps: 1,
+          visited: ["Target Item"],
