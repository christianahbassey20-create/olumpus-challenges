+
+    describe("string target matching", () => {
+      it("should find matching item on the first step", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Target Item");
+
+        const result = await vo.navigateTo("target");
+
+        expect(result).toStrictEqual({
+          found: true,
+          phrase: "Target Item",
+          steps: 1,
+          visited: ["Target Item"],
+        });
+      });
+
+      it("should find matching item after multiple steps", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("First Item")
+          .mockResolvedValueOnce("Second Item")
+          .mockResolvedValueOnce("My Target Here");
+
+        const result = await vo.navigateTo("target");
+
+        expect(result).toStrictEqual({
+          found: true,
+          phrase: "My Target Here",
+          steps: 3,
+          visited: ["First Item", "Second Item", "My Target Here"],
+        });
+      });
+
+      it("should perform case-insensitive substring matching", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Navigation Menu, heading level 2");
+
+        const result = await vo.navigateTo("NAVIGATION MENU");
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("Navigation Menu, heading level 2");
+      });
+
+      it("should not treat different non-initial repeated phrases as a cycle", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Repeat")
+          .mockResolvedValueOnce("Repeat")
+          .mockResolvedValueOnce("The Target");
+
+        const result = await vo.navigateTo("Target");
+
+        expect(result.found).toBe(true);
+        expect(result.steps).toBe(3);
+        expect(result.visited).toStrictEqual([
+          "Repeat",
+          "Repeat",
+          "The Target",
+        ]);
+      });
+
+      it("should match an empty string target against any item", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Anything");
+
+        const result = await vo.navigateTo("");
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("Anything");
+        expect(result.steps).toBe(1);
+      });
+    });
+
+    describe("direction option", () => {
+      it("should navigate backward when direction is previous", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Prev Item")
+          .mockResolvedValueOnce("Target");
+
+        const result = await vo.navigateTo("Target", {
+          direction: "previous",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.steps).toBe(2);
+        expect(result.visited).toStrictEqual(["Prev Item", "Target"]);
+      });
+
+      it("should navigate forward when direction is next", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Found It");
+
+        const result = await vo.navigateTo("Found", { direction: "next" });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("Found It");
+        expect(result.steps).toBe(1);
+      });
+    });
+
+    describe("maxSteps option", () => {
+      it("should stop at maxSteps when no match is found", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValue("Unmatched Item");
+
+        const result = await vo.navigateTo("nonexistent", { maxSteps: 3 });
+
+        expect(result).toStrictEqual({
+          found: false,
+          phrase: "",
+          steps: 3,
+          visited: ["Unmatched Item", "Unmatched Item", "Unmatched Item"],
+        });
+      });
+
+      it("should respect maxSteps of 1", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Not It");
+
+        const result = await vo.navigateTo("nonexistent", { maxSteps: 1 });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(1);
+        expect(result.visited).toHaveLength(1);
+      });
+
+      it("should default to 100 maxSteps", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValue("No Match");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result.steps).toBe(100);
+      });
+    });
+
+    describe("match option with itemText", () => {
+      it("should compare against itemText when match is itemText", async () => {
+        VoiceOverCaptionStub.itemText
+          .mockResolvedValueOnce("Start Text")
+          .mockResolvedValueOnce("Item Text 1")
+          .mockResolvedValueOnce("Target Text Here");
+
+        VoiceOverCaptionStub.lastSpokenPhrase.mockResolvedValue(
+          "spoken phrase"
+        );
+
+        const result = await vo.navigateTo("target text", {
+          match: "itemText",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("Target Text Here");
+        expect(result.steps).toBe(2);
+        expect(result.visited).toStrictEqual([
+          "Item Text 1",
+          "Target Text Here",
+        ]);
+      });
+
+      it("should detect cycle using itemText when match is itemText", async () => {
+        VoiceOverCaptionStub.itemText
+          .mockResolvedValueOnce("Start Text")
+          .mockResolvedValueOnce("Other Text")
+          .mockResolvedValueOnce("Start Text");
+
+        const result = await vo.navigateTo("nonexistent", {
+          match: "itemText",
+        });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(2);
+      });
+    });
+
+    describe("RegExp target", () => {
+      it("should match using a regular expression", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Error: file not found")
+          .mockResolvedValueOnce("heading level 3, Section Title");
+
+        const result = await vo.navigateTo(/^heading level \d/);
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 3, Section Title");
+        expect(result.steps).toBe(2);
+      });
+
+      it("should return not found when regex never matches", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Item")
+          .mockResolvedValueOnce("Start");
+
+        const result = await vo.navigateTo(/^zzz$/);
+
+        expect(result.found).toBe(false);
+      });
+    });
+
+    describe("predicate target", () => {
+      it("should match using a predicate function", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Short")
+          .mockResolvedValueOnce("This is a very long spoken phrase");
+
+        const result = await vo.navigateTo((text) => text.length > 20);
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("This is a very long spoken phrase");
+      });
+
+      it("should treat a throwing predicate as non-matching and continue", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Item 1")
+          .mockResolvedValueOnce("Item 2")
+          .mockResolvedValueOnce("Start");
+
+        const result = await vo.navigateTo(() => {
+          throw new Error("boom");
+        });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(3);
+      });
+    });
+
+    describe("elementType navigation", () => {
+      it("should navigate by heading element type", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("heading level 1, Main Title");
+
+        const result = await vo.navigateTo("Main", {
+          elementType: "heading",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 1, Main Title");
+        expect(result.steps).toBe(1);
+      });
+
+      it("should navigate by link element type", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Skip navigation link")
+          .mockResolvedValueOnce("Home link");
+
+        const result = await vo.navigateTo("Home", {
+          elementType: "link",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.steps).toBe(2);
+      });
+
+      it("should navigate by element type in previous direction", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("heading level 2, Previous Section");
+
+        const result = await vo.navigateTo("Previous", {
+          elementType: "heading",
+          direction: "previous",
+        });
+
+        expect(result.found).toBe(true);
+        expect(result.phrase).toBe("heading level 2, Previous Section");
+        expect(result.steps).toBe(1);
+      });
+
+      it("should throw error for unsupported element type containing the type name", async () => {
+        await expect(
+          vo.navigateTo("text", { elementType: "landmark" } as any)
+        ).rejects.toThrow("landmark");
+      });
+
+      it("should support element type with cycle detection", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("heading level 1, Title")
+          .mockResolvedValueOnce("heading level 2, Subtitle")
+          .mockResolvedValueOnce("heading level 1, Title");
+
+        const result = await vo.navigateTo("nonexistent", {
+          elementType: "heading",
+        });
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(2);
+      });
+    });
+
+    describe("cycle detection", () => {
+      it("should detect cycle when first step returns to start", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Only Item")
+          .mockResolvedValueOnce("Only Item");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result.found).toBe(false);
+        expect(result.steps).toBe(1);
+        expect(result.visited).toStrictEqual(["Only Item"]);
+      });
+
+      it("should detect cycle after multiple steps", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Item A")
+          .mockResolvedValueOnce("Item B")
+          .mockResolvedValueOnce("Start");
+
+        const result = await vo.navigateTo("nonexistent");
+
+        expect(result).toStrictEqual({
+          found: false,
+          phrase: "",
+          steps: 3,
+          visited: ["Item A", "Item B", "Start"],
