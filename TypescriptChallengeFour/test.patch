@@ -0,0 +1,83 @@
+import { matchPattern } from "./matchPattern";
+
+describe("matchPattern", () => {
+  describe("string target", () => {
+    it("should match case-insensitive substring", () => {
+      expect(matchPattern("hello", "Say Hello World")).toBe(true);
+    });
+
+    it("should not match when substring is absent", () => {
+      expect(matchPattern("xyz", "Hello World")).toBe(false);
+    });
+
+    it("should match with entirely different casing", () => {
+      expect(matchPattern("HELLO WORLD", "hello world")).toBe(true);
+    });
+
+    it("should match empty string target against any text", () => {
+      expect(matchPattern("", "anything")).toBe(true);
+    });
+
+    it("should not match non-empty string against empty text", () => {
+      expect(matchPattern("hello", "")).toBe(false);
+    });
+
+    it("should match partial substring within phrase", () => {
+      expect(matchPattern("llo Wo", "Hello World")).toBe(true);
+    });
+  });
+
+  describe("RegExp target", () => {
+    it("should match when regex matches", () => {
+      expect(matchPattern(/world$/i, "Hello World")).toBe(true);
+    });
+
+    it("should not match when regex does not match", () => {
+      expect(matchPattern(/^world/, "Hello World")).toBe(false);
+    });
+
+    it("should support regex flags", () => {
+      expect(matchPattern(/hello/i, "HELLO")).toBe(true);
+    });
+
+    it("should match regex anchored to full text", () => {
+      expect(matchPattern(/^Hello World$/, "Hello World")).toBe(true);
+    });
+
+    it("should support alternation in regex", () => {
+      expect(matchPattern(/(hello)|(world)/i, "say World")).toBe(true);
+    });
+  });
+
+  describe("predicate target", () => {
+    it("should return true when predicate returns true", () => {
+      expect(
+        matchPattern((text) => text.includes("world"), "hello world")
+      ).toBe(true);
+    });
+
+    it("should return false when predicate returns false", () => {
+      expect(matchPattern((text) => text.length > 100, "short")).toBe(false);
+    });
+
+    it("should treat predicate that throws as non-matching", () => {
+      expect(
+        matchPattern(() => {
+          throw new Error("boom");
+        }, "text")
+      ).toBe(false);
+    });
+
+    it("should support complex predicate logic", () => {
+      const target = (text: string) =>
+        text.startsWith("Section") && text.includes("Header");
+      expect(matchPattern(target, "Section - Main Header")).toBe(true);
+      expect(matchPattern(target, "Section - Footer")).toBe(false);
+    });
+
+    it("should coerce truthy predicate return to boolean", () => {
+      expect(matchPattern((() => 1) as unknown as (text: string) => boolean, "text")).toBe(true);
+      expect(matchPattern((() => 0) as unknown as (text: string) => boolean, "text")).toBe(false);
+    });
+  });
+});
