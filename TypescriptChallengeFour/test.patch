+      });
+
+      it("should find matching item after multiple steps", async () => {
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("First Item")
+          .mockResolvedValueOnce("Second Item")
+          .mockResolvedValueOnce("My Target Here");
+
+        const result = await vo.navigateTo("target");
+
+        expect(result).toStrictEqual({
+          found: true,
+          phrase: "My Target Here",
