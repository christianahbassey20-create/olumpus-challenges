+        const navPhrases = ["Step 1", "Step 2", "Target"];
+        let navIdx = 0;
+
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Step 1")
+          .mockResolvedValueOnce("Step 2")
+          .mockResolvedValueOnce("Target");
+
+        VoiceOverCursorStub.next.mockImplementation(async () => {
+          itemLog.push(navPhrases[navIdx++]);
+        });
+
+        VoiceOverCaptionStub.itemTextLog.mockImplementation(
+          async () => [...itemLog]
+        );
+
+        const result = await vo.navigateTo("Target");
+
+        const log = await VoiceOverCaptionStub.itemTextLog();
+        expect(log).toStrictEqual(["Step 1", "Step 2", "Target"]);
+        expect(log).toStrictEqual(result.visited);
+      });
+
+      it("should record backward navigation steps in spokenPhraseLog", async () => {
+        const spokenLog: string[] = [];
+        const navPhrases = ["Prev 1", "Found"];
+        let navIdx = 0;
+
+        VoiceOverCaptionStub.lastSpokenPhrase
+          .mockResolvedValueOnce("Start")
+          .mockResolvedValueOnce("Prev 1")
+          .mockResolvedValueOnce("Found");
+
+        VoiceOverCursorStub.previous.mockImplementation(async () => {
+          spokenLog.push(navPhrases[navIdx++]);
+        });
+
+        VoiceOverCaptionStub.spokenPhraseLog.mockImplementation(
+          async () => [...spokenLog]
+        );
+
+        await vo.navigateTo("Found", { direction: "previous" });
+
+        const log = await VoiceOverCaptionStub.spokenPhraseLog();
