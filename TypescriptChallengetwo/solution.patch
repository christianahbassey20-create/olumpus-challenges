+"""
+Throttle-specific Django signals.
+
+These signals are dispatched from the _check_throttles method in Operation
+to notify listeners about throttle decisions for each request.
+"""
+from django.dispatch import Signal
+
+# Fired for each throttle that permits a request.
+# Provides: sender (throttle class), request, throttle (instance)
+throttle_request_allowed = Signal()
+
+# Fired for each throttle that denies a request.
+# Provides: sender (throttle class), request, throttle (instance)
+throttle_request_denied = Signal()
