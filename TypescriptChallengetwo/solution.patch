new file mode 100644
index 0000000..54656b0
--- /dev/null
+++ b/ninja_extra/throttling/backends.py
@@ -0,0 +1,120 @@
+"""
+Abstract throttle backend and cache-based implementation.
+"""
+import abc
+from typing import Any, Dict, Optional
+
+from django.core.cache import cache as default_cache
+
+
+class ThrottleBackend(abc.ABC):
+    """
+    Abstract base class for throttle state storage backends.
+
+    All throttle backends must implement get_state, set_state, and delete_state
+    to provide a consistent interface for throttle classes to persist their
+    per-client state (token counts, slot lists, timestamps, etc.).
+    """
+
+    @abc.abstractmethod
+    def get_state(self, key: str) -> Optional[Dict[str, Any]]:
+        """
+        Retrieve the stored state for the given key.
+
+        Returns:
+            The stored state dictionary, or None if no state exists.
+        """
+        ...  # pragma: no cover
+
+    @abc.abstractmethod
+    def set_state(self, key: str, state: Dict[str, Any], ttl: Optional[int] = None) -> None:
+        """
+        Store state for the given key.
+
+        Args:
+            key: The cache key to store state under.
+            state: A dictionary of state data to persist.
+            ttl: Optional time-to-live in seconds. If None, use the backend's
+                 default expiry behavior.
+        """
+        ...  # pragma: no cover
+
+    @abc.abstractmethod
+    def delete_state(self, key: str) -> None:
+        """
+        Remove the stored state for the given key.
+
+        Args:
+            key: The cache key whose state should be deleted.
+        """
+        ...  # pragma: no cover
+
+
+class CacheThrottleBackend(ThrottleBackend):
+    """
+    Throttle backend that delegates storage to Django's cache framework.
+
+    Uses the default cache (django.core.cache.cache) to store and retrieve
+    throttle state. This is the default backend for all new throttle classes.
+
+    The cache key namespace and TTL behavior are determined by the throttle
+    classes that use this backend. This backend simply provides a thin
+    wrapper around Django's cache get/set/delete operations, ensuring the
+    state is serialized as dictionaries.
+
+    Attributes:
+        cache: The Django cache instance to use for storage. Defaults to
+               the default cache configured in settings.
+    """
+
+    def __init__(self, cache: Any = None) -> None:
+        """
+        Initialize the cache backend.
+
+        Args:
+            cache: An optional Django cache instance. If not provided,
+                   django.core.cache.cache (the default cache) is used.
+        """
+        self.cache = cache if cache is not None else default_cache
+
+    def get_state(self, key: str) -> Optional[Dict[str, Any]]:
+        """
+        Retrieve state from the Django cache.
+
+        Args:
+            key: The cache key to look up.
+
+        Returns:
+            The stored state dictionary, or None if the key does not exist
+            or has expired.
+        """
+        value = self.cache.get(key)
+        if value is None:
+            return None
+        if isinstance(value, dict):
+            return value
+        return None
+
+    def set_state(self, key: str, state: Dict[str, Any], ttl: Optional[int] = None) -> None:
+        """
+        Store state in the Django cache.
+
+        Args:
+            key: The cache key to store under.
+            state: The state dictionary to persist.
+            ttl: Time-to-live in seconds. If None, uses the cache's default
+                 timeout.
+        """
+        if ttl is not None:
+            self.cache.set(key, state, ttl)
+        else:
+            self.cache.set(key, state)
+
+    def delete_state(self, key: str) -> None:
+        """
+        Remove state from the Django cache.
+
+        Args:
+            key: The cache key to delete.
+        """
+        self.cache.delete(key)
diff --git a/ninja_extra/throttling/model.py b/ninja_extra/throttling/model.py
