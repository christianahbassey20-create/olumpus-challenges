+    def test_token_bucket_period_aliases_s_h_d_day(self):
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        class AliasBucket(TokenBucketThrottle):
+            scope = "test_alias"
+
+            def get_cache_key(self, request):
+                return "alias_" + str(id(self))
+
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "1.0.0.2"
+
+        for rate_str, capacity in [("3/s", 3), ("3/h", 3), ("3/d", 3), ("3/day", 3)]:
+            cache.clear()
+            throttle = AliasBucket(rate=rate_str)
+            for _ in range(capacity):
+                assert throttle.allow_request(request) is True
+            assert throttle.allow_request(request) is False
