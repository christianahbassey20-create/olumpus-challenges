+class TestTokenBucketImportAndSubclass:
+    def test_token_bucket_importable_from_throttling(self):
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        assert TokenBucketThrottle is not None
+
+    def test_token_bucket_is_subclass_of_simple_rate_throttle(self):
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        assert issubclass(TokenBucketThrottle, SimpleRateThrottle)
+
+    def test_token_bucket_accepts_rate_string(self):
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        class MyBucket(TokenBucketThrottle):
+            scope = "test_bucket"
+
+            def get_cache_key(self, request):
+                return "test_key_rate_string"
+
+        throttle = MyBucket(rate="10/min")
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "1.0.0.1"
+        # 10 requests should be allowed, 11th denied
+        for _ in range(10):
+            assert throttle.allow_request(request) is True
+        assert throttle.allow_request(request) is False
+
