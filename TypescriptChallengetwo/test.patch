+
+            def get_cache_key(self, request):
+                return "token_bucket_test_refill_timed"
+
+        throttle = TimedBucket(rate="5/min")
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "4.4.4.4"
+
+        timer_value[0] = 0.0
+        for _ in range(5):
+            throttle.allow_request(request)
+        assert throttle.allow_request(request) is False
+
+        timer_value[0] = 12.0
