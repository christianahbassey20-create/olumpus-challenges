+class TestTokenBucketScopeLookup:
+    def setup_method(self):
+        cache.clear()
+
+    def test_scope_based_rate_lookup(self, monkeypatch):
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        with monkeypatch.context() as m:
+            m.setattr(
+                settings, "THROTTLE_RATES",
+                {"bucket_scope": "5/min", "user": None, "anon": None},
+            )
+
+            class ScopedBucket(TokenBucketThrottle):
+                scope = "bucket_scope"
+
+                def get_cache_key(self, request):
+                    return "token_bucket_bucket_scope_scoped"
+
+            throttle = ScopedBucket()
+
+            request = HttpRequest()
+            request.META["REMOTE_ADDR"] = "9.9.9.9"
+            for _ in range(5):
+                assert throttle.allow_request(request) is True
+            assert throttle.allow_request(request) is False
+
+    def test_cache_key_is_stable_and_scope_isolated(self):
+        """Cache keys are not None, stable across calls, and different scopes produce different keys."""
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        class ScopeA(TokenBucketThrottle):
+            scope = "scope_a"
+            def get_cache_key(self, request):
+                ident = self.get_ident(request) or "anon"
+                return self.cache_format % {"scope": self.scope, "ident": ident}
+
+        class ScopeB(TokenBucketThrottle):
+            scope = "scope_b"
+            def get_cache_key(self, request):
+                ident = self.get_ident(request) or "anon"
+                return self.cache_format % {"scope": self.scope, "ident": ident}
+
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "11.11.11.11"
+        key_a = ScopeA(rate="5/min").get_cache_key(request)
+        key_b = ScopeB(rate="5/min").get_cache_key(request)
+        assert key_a is not None
+        assert key_b is not None
+        assert key_a != key_b
+        # Same scope produces same key
+        assert ScopeA(rate="5/min").get_cache_key(request) == key_a
+
+    def test_convenience_subclass_keys_derived_from_scope_and_ident(self):
+        """UserTokenBucketThrottle keys vary by user; AnonTokenBucketThrottle keys vary by IP."""
+        from ninja_extra.throttling import AnonTokenBucketThrottle, UserTokenBucketThrottle
+
+        user_throttle = UserTokenBucketThrottle(rate="5/min")
+        req = HttpRequest()
+        user = MockUser("ScopeIdentUser")
+        user.set_id(501)
+        req.user = user
+        req.META["REMOTE_ADDR"] = "11.11.11.12"
+        user_key = user_throttle.get_cache_key(req)
+        assert user_key is not None
+
+        anon_throttle = AnonTokenBucketThrottle(rate="5/min")
+        anon_req = HttpRequest()
+        anon_req.user = None
+        anon_req.META["REMOTE_ADDR"] = "11.11.11.13"
+        anon_key = anon_throttle.get_cache_key(anon_req)
+        assert anon_key is not None
+
+        # Different throttle types / different idents produce different keys
+        assert user_key != anon_key
+
