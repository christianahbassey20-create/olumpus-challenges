+class TestTokenBucketBasicBehavior:
+    def setup_method(self):
+        cache.clear()
+
+        from ninja_extra.throttling import TokenBucketThrottle
+
+        class BucketThrottle(TokenBucketThrottle):
+            scope = "test_bucket_basic"
+            cache_format = "token_bucket_%(scope)s_%(ident)s"
+
+            def get_cache_key(self, request):
+                ident = self.get_ident(request) or "test"
+                return self.cache_format % {"scope": self.scope, "ident": ident}
+
+        self.throttle_class = BucketThrottle
+
+    def test_allows_requests_up_to_capacity(self):
+        throttle = self.throttle_class(rate="5/min")
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "1.1.1.1"
+
+        for _ in range(5):
+            assert throttle.allow_request(request) is True
+
+    def test_denies_request_after_capacity_exhausted(self):
+        throttle = self.throttle_class(rate="5/min")
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "2.2.2.2"
+
+        for _ in range(5):
+            throttle.allow_request(request)
+        assert throttle.allow_request(request) is False
+
+    def test_allows_burst_at_full_capacity(self):
+        throttle = self.throttle_class(rate="10/sec")
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "3.3.3.3"
+
+        results = []
+        for _ in range(10):
+            results.append(throttle.allow_request(request))
+        assert all(results), "All requests within capacity should be allowed"
+        assert throttle.allow_request(request) is False
+
