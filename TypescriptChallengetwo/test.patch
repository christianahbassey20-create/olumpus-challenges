+    def test_partial_window_slide(self):
+        """Only the oldest requests slide out; newer ones remain in the window."""
+        from ninja_extra.throttling import SlidingWindowThrottle
+
+        timer_value = [0.0]
+
+        class TimedSW(SlidingWindowThrottle):
+            scope = "sw_partial"
+
+            def timer(self):
+                return timer_value[0]
+
+            def get_cache_key(self, request):
+                return "sliding_window_sw_partial_slide"
+
+        throttle = TimedSW(rate="3/min")
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "80.0.0.4"
+
+        # Make 3 requests at t=0, t=20, t=40
+        for t in [0.0, 20.0, 40.0]:
+            timer_value[0] = t
+            throttle.allow_request(request)
+
+        # At t=50, window is [0..50), all 3 are within 60s -> denied
+        timer_value[0] = 50.0
+        assert throttle.allow_request(request) is False
+
+        # At t=61, only t=0 has slid out -> 2 in window, 1 slot free -> allowed
+        timer_value[0] = 61.0
+        assert throttle.allow_request(request) is True
+        # Now 3 in window again (t=20, t=40, t=61) -> denied
+        assert throttle.allow_request(request) is False
