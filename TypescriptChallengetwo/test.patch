+class TestCacheKeyIsolation:
+    """Verify that different throttle types produce non-overlapping cache keys."""
+
+    def setup_method(self):
+        cache.clear()
+
+    def test_token_bucket_and_sliding_window_keys_differ(self):
+        from ninja_extra.throttling import SlidingWindowThrottle, TokenBucketThrottle
+
+        class TBKey(TokenBucketThrottle):
+            scope = "shared_scope"
+            def get_cache_key(self, request):
+                ident = self.get_ident(request) or "anon"
+                return self.cache_format % {"scope": self.scope, "ident": ident}
+
+        class SWKey(SlidingWindowThrottle):
+            scope = "shared_scope"
+            def get_cache_key(self, request):
+                ident = self.get_ident(request) or "anon"
+                return self.cache_format % {"scope": self.scope, "ident": ident}
+
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "88.0.0.1"
+
+        tb_key = TBKey(rate="5/min").get_cache_key(request)
+        sw_key = SWKey(rate="5/min").get_cache_key(request)
+
+        assert tb_key is not None
+        assert sw_key is not None
+        # Different throttle types must produce different cache keys
+        assert tb_key != sw_key
+        # Verify format prefixes
+        assert tb_key.startswith("token_bucket_")
+        assert sw_key.startswith("sliding_window_")
+
+    def test_concurrent_and_token_bucket_keys_differ(self):
+        from ninja_extra.throttling import ConcurrentRateThrottle, TokenBucketThrottle
+
+        class TBKey2(TokenBucketThrottle):
+            scope = "iso_scope"
+            def get_cache_key(self, request):
+                ident = self.get_ident(request) or "anon"
+                return self.cache_format % {"scope": self.scope, "ident": ident}
+
+        request = HttpRequest()
+        request.META["REMOTE_ADDR"] = "88.0.0.2"
+
+        tb_key = TBKey2(rate="5/min").get_cache_key(request)
+        cr = ConcurrentRateThrottle(max_concurrent=2)
+        cr_key = cr.get_cache_key(request)
+
+        assert tb_key is not None
+        assert cr_key is not None
+        assert tb_key != cr_key
+        assert cr_key.startswith("concurrent_")
+
